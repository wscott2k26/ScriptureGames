# Scripture Games stays local-first and fully usable without cloud variables.
EXPO_PUBLIC_USE_REMOTE_API=false
EXPO_PUBLIC_BACKEND_URL=https://your-api.example.com

# Optional Supabase cloud backup. Use only public mobile credentials.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_public_key

# Never place SUPABASE_SERVICE_ROLE_KEY in the mobile app, Expo public variables,
# EAS public environment values, or client-visible source.
