# The signed 1.0.0 TestFlight app is local-first and works with no backend variables.
# The legacy remote game API remains disabled unless BOTH values are deliberately enabled.
EXPO_PUBLIC_USE_REMOTE_API=false
EXPO_PUBLIC_BACKEND_URL=https://your-api.example.com

# Optional Scripture Games cloud backup for the 1.1 candidate.
# Leave both blank to keep the feature safely disabled.
# Use only the public project URL and public anonymous key in the mobile app.
# Never place the Supabase service-role key in Expo, EAS, GitHub client files, or EXPO_PUBLIC variables.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
